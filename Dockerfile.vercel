FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    APP_ENV=production \
    APP_DEBUG=false \
    MODELS_DIR=/models \
    SCIENTIFIC_RUNTIME_DIR=/scientific \
    ASSESSMENT_EXECUTION_MODE=inline \
    ASSESSMENT_WAIT_FOR_RESULT=true \
    PYTHONPATH=/scientific \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libxrender1 libxext6 libsm6 tesseract-ocr tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt scientific/requirements.worker.txt ./
RUN pip install --only-binary=:all: -r requirements.txt -r requirements.worker.txt

COPY backend/ ./
COPY scientific/*.py /scientific/
COPY scientific/qsar/ /scientific/qsar/
COPY scientific/models/ /models/

RUN test -s /models/skin_model.pkl \
    && test -s /models/eye_model.pkl \
    && test -s /models/sens_model.pkl \
    && test -s /models/acute_model.pkl \
    && test -s /models/candidate_v3/skin_dryness_model.pkl \
    && tesseract --version >/dev/null

EXPOSE 80

# Database migrations and catalogue seeding are run separately for each branch.
CMD ["sh", "-c", "exec uvicorn app.vercel:app --host 0.0.0.0 --port ${PORT:-80}"]
