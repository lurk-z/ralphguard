FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MODELS_DIR=/app/models

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    libxrender1 \
    libxext6 \
    libsm6 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.worker.txt ./requirements.worker.txt
RUN pip install -r requirements.worker.txt

COPY . .

RUN test -s /app/models/skin_model.pkl \
    && test -s /app/models/eye_model.pkl \
    && test -s /app/models/sens_model.pkl \
    && test -s /app/models/acute_model.pkl \
    && test -s /app/models/candidate_v3/skin_dryness_model.pkl \
    && useradd --create-home --uid 10001 ralphguard \
    && chown -R ralphguard:ralphguard /app

USER ralphguard

CMD ["python", "worker.py"]
